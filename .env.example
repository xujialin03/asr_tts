# Copy to .env and fill in. These credentials create the local PostgreSQL
# database/user and are reused by the voiceprint service (compose wires them
# into VOICEPRINT_DATABASE_URL automatically). Keep them in sync with the
# database section of config.yaml.
POSTGRES_DB=qwen3_asr
POSTGRES_USER=qwen3_asr
POSTGRES_PASSWORD=change-me

# These are initial operating points, not security guarantees. Calibrate with
# recordings from the real microphone and room before relying on them.
VOICEPRINT_IDENTIFY_THRESHOLD=0.55
VOICEPRINT_UNCERTAIN_THRESHOLD=0.45

# Optional sherpa-onnx keyword spotting service.
KWS_KEYWORDS_SCORE=1.5
KWS_KEYWORDS_THRESHOLD=0.20
KWS_NUM_TRAILING_BLANKS=1
