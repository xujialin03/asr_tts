# Copy to config.yaml at the repo root and fill in your service addresses.
services:
  asr:
    host: 127.0.0.1
    port: 9020
  tts:
    name: breeze-tts-2
    host: 127.0.0.1
    port: 7860
  llm:
    host: 127.0.0.1
    port: 9090

llm:
  model_id: your-model-id
  api_key: empty
  temperature: 0.7
  role_prompt: |
    # Role: 你的角色设定
    在这里写系统提示词（人设、互动方式、语言风格）。

tts:
  prompt: "音色/语气提示词"
  # 固定参考音频（zero-shot 音色克隆），用于锁定音色。路径相对 backend/ 目录。
  # ref_text 是参考音频对应的文字，可用 ASR 服务转写得到。
  ref_audio: assets/ref_voice.wav
  ref_text: "参考音频对应的文字内容"
