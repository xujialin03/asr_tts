# Copy to config.yaml at the repo root and fill in your service addresses.
services:
  asr:
    # OpenAI-compatible ASR gateway. Provide either base_url (preferred, with
    # the /v1 prefix) or host + port. api_key is sent as a Bearer token.
    base_url: http://127.0.0.1:30080/v1
    model: qwen3-asr
    # api_key: ""
    timeout_seconds: 60
  tts:
    name: breeze-tts-2
    host: 127.0.0.1
    port: 7860
  voiceprint:
    name: campplus
    host: 127.0.0.1
    port: 8002
  kws:
    enabled: true
    name: sherpa-onnx
    host: 127.0.0.1
    port: 8003
    # KWS unavailable时降级为原有精确文本唤醒，不阻断对话。
    fail_open: true

# PostgreSQL used by project-owned agent modules (for example, voice profiles).
# The compose stack runs a dedicated postgres on host port 5433 (5432 is left
# free for other projects). Keep these in sync with POSTGRES_* in .env.
database:
  postgresql:
    host: 127.0.0.1
    port: 5433
    database: qwen3_asr
    user: qwen3_asr
    password: change-me

# 角色模型（AgentProfile）：注入决策模型交互判断，让模型知道“助手是谁”。
# 进程内 direct-LLM agent 另有一份 SYSTEM_PROMPT 人设；这里只用于“是否面向 AI / 是否回应”的判断。
agent:
  name: 志玲
  role: 语音助理
  persona: "你叫志玲，是一名语音助理，正在多人语音房间里通过麦克风听取用户发言，判断用户是否在对你说话。"

assistant:
  wake_words:
    - 志玲
    - 志玲姐姐
    - 志宁
    - 志凌
    - 诗林
    - 志林
    - 姐姐
    - 小助手
  active_window_seconds: 20
  # AI 播放时，只有 ASR 文本命中这些正则才触发打断。
  interrupt_patterns:
    - "等(?:一)?下"
    - "慢着"
    - "停(?:一)?下"
    - "暂停(?:一下)?"
    - "先别说(?:了)?"
    - "别说(?:了)?"
    - "打住"
  # 延续性兜底：决策模型判“面向AI但不回应”时，若文本命中这些疑问/延续线索，
  # 且参与人在活跃窗口内、窗口里有助理上一轮回复，则兜底进入回复流程。
  followup_markers:
    - "是不是"
    - "有没有"
    - "能不能"
    - "要不要"
    - "怎么"
    - "为什么"
    - "什么"
    - "多少"
    - "几点"
    - "哪里"
    - "哪个"
    - "哪些"
    - "吗"
    - "呢"
    - "吧"
  followup_sentence_finals: ["?", "？", "吗", "呢", "吧", "啊", "呀"]

# 输入缓冲区：VAD 停顿会把一句话切成多段。决策模型判为“未说完”的残句会暂存，
# 等待同一说话人的后续片段合并成完整句子后再发给对话 Agent。
buffer:
  enabled: true
  max_wait_seconds: 3.0   # 超过此时长未等到后续片段，则放弃合并、按原样处理
  max_segments: 4         # 最多合并几段
  max_chars: 200          # 合并后文本超过此长度则不再等待

# 交互决策模型：OpenAI 兼容生成式模型，判断“是否面向 AI / 是否回应”。
decision_model:
  base_url: http://mo.sy.cn:8000/v1
  model: qwen3.6-35b-awq
  # api_key: ""
  timeout_seconds: 8.0
  max_tokens: 512
  # 关闭思考：思考模式会把输出预算烧光导致 JSON 截断，且延迟 ~3s；关思考 ~1s。
  enable_thinking: false
  max_retries: 3

# 对话回复由进程内 direct-LLM agent 提供（backend/conversation_agent.py），
# 调用下面的 OpenAI 兼容模型。
direct_llm:
  base_url: http://127.0.0.1:9090/v1
  model: your-model-id
  # api_key: ""
  timeout_seconds: 30
  max_tokens: 512
  temperature: 0.7
  enable_thinking: false

# LeRobot SO101 局域网 MCP（Streamable-HTTP JSON-RPC）。由进程内 direct-LLM agent 使用；
# enabled=true 且 token 非空时 teleop.* 技能才会注入系统提示词。
# 同一服务暴露 9 个工具：4 个遥操 + 4 个推理 + 1 个双摄视觉问答。
# start_teleoperation / start_inference 会使实体机械臂通电运动，属危险操作。
# Token 等同遥操与推理控制权限：写在 gitignored 的 config.yaml 里，或用环境变量 TELEOP_MCP_TOKEN。
teleop:
  enabled: false
  url: http://192.168.200.30:8791/mcp
  token: ""
  timeout_seconds: 30

tts:
  # direct-LLM agent 会为每条回复生成动态 instruction；prompt 仅在未返回时作为兜底。
  prompt: "用温柔、自然、亲切的语气表达，语速适中。"
  # instruction 遵循强度；Breeze-TTS-2 Voice Direction 推荐使用 4。
  cfg_scale: 4
  # 固定参考音频（zero-shot 音色克隆），用于锁定音色。路径相对 backend/ 目录。
  # ref_text 是参考音频对应的文字，可用 ASR 服务转写得到。
  ref_audio: assets/ref_voice.wav
  ref_text: "参考音频对应的文字内容"
